# Copy to .env for `npm run dev` (Vite loads it; SvelteKit exposes PUBLIC_* to the browser).
# Clerk - https://dashboard.clerk.com -> API keys
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Where the API worker is reachable from the SvelteKit server (both services)
API_BASE_URL=http://localhost:8787
# Optional: one URL per service, each defaulting to API_BASE_URL. Set both to
# run the UI against the spec repo's Microcks mocks (`task mocks:up`, or just
# `task dev:mocks`), which serve each service at its own path:
# API_CLIENTS_URL=http://localhost:8585/rest/Clients+API/1.0.0
# API_WALKS_URL=http://localhost:8585/rest/Walks+API/1.0.0
# Optional: skip Clerk entirely against an API running in test auth mode.
# The API accepts `Bearer test:<walker_id>` when its AUTH_MODE is `test`;
# the mocks accept anything (API_DEV_BEARER=mock).
# API_DEV_BEARER=test:walker-anna
